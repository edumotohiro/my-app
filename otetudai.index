            { id: 'water_smart_7', level: 7, name: 'アクアユニコーン', emoji: '🦄', subEmoji: '❄️', desc: 'こおりと 水の まほうをあやつる 美しく かしこい 水の精霊。' },
            { id: 'water_smart_8', level: 8, name: 'グレイシアドラゴン', emoji: '🐉', subEmoji: '❄️', desc: 'きらめく 氷のつばさを もつ クールで 頭脳派の 氷水竜！' },
            { id: 'water_smart_9', level: 9, name: 'オーロラセイレーン竜', emoji: '🐲', subEmoji: '🌌', desc: 'よぞらの オーロラを まとった せいなる 知恵の海竜。' },
