          { id: 'water_common_2', level: 2, name: 'アワプク', emoji: '🫧', subEmoji: '💧', desc: 'タマゴから うまれたばかり！あわを ぷくぷく ふくのが とくい。' },
          { id: 'water_common_3', level: 3, name: 'アクアペンギン', emoji: '🐧', subEmoji: '💧', desc: 'すいすい およぐのが 大すきな 元気いっぱいの 水モンスター！' },
          { id: 'water_common_4', level: 4, name: 'スプラッシュドルフィン', emoji: '🐬', subEmoji: '🌊', desc: '大ジャンプが できるようになった！つぎの進化で すがたが大きくかわるぞ！' }
        ],
        branches: {
          power: [
