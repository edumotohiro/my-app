      </div>

      <!-- お手伝い設定パネル -->
      <div id="settings-chores-panel">
        <div class="bg-slate-100 p-3 rounded-2xl border-2 border-slate-300 mb-4 space-y-2.5">
          <div id="chore-form-heading" class="font-black text-sm">➕ 新しいお<ruby>手伝<rt>てつだ</rt></ruby>いをついか</div>
          <input type="hidden" id="edit-chore-id">
          <div>
            <label class="block text-xs font-extrabold mb-1">お<ruby>手伝<rt>てつだ</rt></ruby>いのなまえ</label>
