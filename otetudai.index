  <!-- ==================== モーダル7：おうちのひと設定 ==================== -->
  <div id="modal-settings" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center p-3">
    <div class="game-box-lg bg-white rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-4 sm:p-5">
      <h2 class="text-lg sm:text-xl font-black text-center mb-3">⚙️ おうちのひと<ruby>設定<rt>せってい</rt></ruby></h2>

      <!-- 設定内タブ -->
