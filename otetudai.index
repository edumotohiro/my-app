      </div>

      <!-- ごほうび設定パネル -->
      <div id="settings-rewards-panel" class="hidden">
        <div class="bg-slate-100 p-3 rounded-2xl border-2 border-slate-300 mb-4 space-y-2.5">
          <div id="reward-form-heading" class="font-black text-sm">➕ 新しいごほうびをついか</div>
          <input type="hidden" id="edit-reward-id">
          <div>
            <label class="block text-xs font-extrabold mb-1">ごほうびのなまえ</label>
