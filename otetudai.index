            <div>
              <label class="block text-xs font-extrabold mb-1">ポイント（pt）</label>
              <input type="number" id="input-chore-pt" class="w-full border-2 border-slate-900 rounded-xl px-3 py-2 font-bold text-sm" min="1" max="50" value="2">
            </div>
            <div>
              <label class="block text-xs font-extrabold mb-1">タイプ（進化ルート）</label>
              <select id="input-chore-cat" class="w-full border-2 border-slate-900 rounded-xl px-2 py-2 font-bold text-sm bg-white">
                <option value="power">🔥 パワー系</option>
                <option value="smart">💧 ちえ・きれい系</option>
                <option value="kind">🌿 やさしさ系</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-extrabold mb-1">アイコン</label>
            <div id="chore-emoji-picker" class="flex flex-wrap gap-1.5"></div>
          </div>
          <div class="flex gap-2 pt-1">
            <button type="button" id="save-chore-btn" class="game-btn flex-1 bg-green-500 text-white font-black py-2 rounded-xl text-sm">ほぞんする</button>
            <button type="button" id="cancel-chore-edit-btn" class="game-btn bg-slate-200 font-black px-3 py-2 rounded-xl text-sm hidden">やめる</button>
          </div>
        </div>
        <div class="font-black text-xs mb-2">登録されているお<ruby>手伝<rt>てつだ</rt></ruby>い一覧</div>
