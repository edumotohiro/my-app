            <button type="button" id="cancel-reward-edit-btn" class="game-btn bg-slate-200 font-black px-3 py-2 rounded-xl text-sm hidden">やめる</button>
          </div>
        </div>
        <div class="font-black text-xs mb-2">登録されているごほうび一覧</div>
        <div id="settings-reward-list" class="space-y-2"></div>
      </div>

      <div class="border-t-2 border-slate-200 mt-5 pt-3 text-center">
        <button type="button" id="reset-all-data-btn" class="game-btn bg-red-500 text-white text-xs font-black px-4 py-2 rounded-xl">
          ⚠️ データをすべてしょき化する
        </button>
      </div>

      <button type="button" onclick="closeModal('modal-settings')" class="game-btn w-full bg-slate-200 font-black py-2.5 rounded-2xl mt-4">
        せっていをおわる
      </button>
    </div>
  </div>

  <script>
    /* =========================================================================
       1. サウンドシステム（Web Audio API シンセ効果音）
       ========================================================================= */
    const SoundFX = {
      ctx: null,
      muted: false,

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },

      playTone(freq, type, duration, delay = 0, gainVal = 0.16) {
        if (this.muted) return;
        this.init();
        if (!this.ctx) return;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime + delay);

        gain.gain.setValueAtTime(gainVal, this.ctx.currentTime + delay);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + delay + duration);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(this.ctx.currentTime + delay);
        osc.stop(this.ctx.currentTime + delay + duration);
      },

      playCoin() {
        this.playTone(987.77, 'sine', 0.11, 0, 0.18);
        this.playTone(1318.51, 'sine', 0.25, 0.08, 0.18);
      },

      playMonsterCry(level) {
        const base = 280 + level * 42;
        this.playTone(base, 'triangle', 0.12, 0, 0.18);
        this.playTone(base * 1.35, 'triangle', 0.18, 0.09, 0.18);
      },

      playFanfare() {
        const notes = [
          { f: 523.25, d: 0.11, t: 0.00 },
          { f: 523.25, d: 0.11, t: 0.13 },
          { f: 523.25, d: 0.11, t: 0.26 },
          { f: 659.25, d: 0.24, t: 0.39 },
          { f: 587.33, d: 0.20, t: 0.65 },
          { f: 659.25, d: 0.20, t: 0.87 },
          { f: 783.99, d: 0.55, t: 1.10 }
        ];
        notes.forEach(n => this.playTone(n.f, 'triangle', n.d, n.t, 0.2));
      },

      playCancel() {
        this.playTone(330, 'sine', 0.11, 0, 0.14);
        this.playTone(261.63, 'sine', 0.16, 0.09, 0.14);
      }
    };

    /* =========================================================================
       2. モンスター進化データベース（3属性 × 10段階 × Lv.5から3分岐 = 全39種類）
       ========================================================================= */
    // 各レベルに到達するための周回内育成ポイントしきい値（10段階）
    const LEVEL_THRESHOLDS = [
      { level: 1, minPt: 0 },
      { level: 2, minPt: 4 },
      { level: 3, minPt: 10 },
      { level: 4, minPt: 18 },
      { level: 5, minPt: 28 }, // ここで3ルートに分岐！
      { level: 6, minPt: 40 },
      { level: 7, minPt: 54 },
      { level: 8, minPt: 70 },
      { level: 9, minPt: 88 },
      { level: 10, minPt: 110 } // 最終進化（殿堂入り）
    ];

    const ATTR_META = {
      fire: {
        label: '🔥 ほのお',
        badgeBg: 'bg-red-500 text-white',
        cardGradient: 'from-red-100 via-amber-50 to-orange-100',
        auraColor: '#f97316',
        ringColor: '#ef4444'
      },
      water: {
        label: '💧 みず',
        badgeBg: 'bg-blue-500 text-white',
        cardGradient: 'from-sky-100 via-cyan-50 to-blue-100',
        auraColor: '#38bdf8',
        ringColor: '#2563eb'
      },
      forest: {
        label: '🌿 もり',
        badgeBg: 'bg-green-600 text-white',
        cardGradient: 'from-lime-100 via-emerald-50 to-green-100',
        auraColor: '#4ade80',
        ringColor: '#16a34a'
      }
    };

    const BRANCH_META = {
      power: { label: '🔥 パワールート', short: 'パワー', color: 'text-red-600', icon: '🔥' },
      smart: { label: '💧 ちえルート', short: 'ちえ', color: 'text-blue-600', icon: '💧' },
      kind:  { label: '🌿 やさしさルート', short: 'やさしさ', color: 'text-green-600', icon: '🌿' }
    };

    // 全39種類のモンスター定義
    // id規則: `${attr}_common_${1..4}` または `${attr}_${branch}_${5..10}`
    const MONSTER_DB = {
      // ---------------- 🔥 ほのお属性 ----------------
      fire: {
        common: [
          { id: 'fire_common_1', level: 1, name: 'ほのおのタマゴ', emoji: '🥚', subEmoji: '🔥', desc: 'あたたかい ほのおのエネルギーをつつんだ ふしぎなタマゴ。' },
          { id: 'fire_common_2', level: 2, name: 'ヒノタマ', emoji: '🐣', subEmoji: '🔥', desc: 'タマゴから うまれたばかり！しっぽに 小さな炎が ともっている。' },
          { id: 'fire_common_3', level: 3, name: 'メラリザード', emoji: '🦎', subEmoji: '🔥', desc: 'げんきいっぱい 走りまわる 炎のトカゲ。おてつだいが 大好き！' },
          { id: 'fire_common_4', level: 4, name: 'ブレイズドン', emoji: '🦖', subEmoji: '💥', desc: 'ツノが はえて たくましくなった！つぎの進化で すがたが大きくかわるぞ！' }
        ],
        branches: {
          power: [
            { id: 'fire_power_5', level: 5, name: 'マグマザウルス', emoji: '🦖', subEmoji: '🌋', desc: '【パワールート】ちからじまんの 炎の恐竜！岩もくだく パワーをもつ。' },
            { id: 'fire_power_6', level: 6, name: 'ボルケーノレックス', emoji: '🐉', subEmoji: '🌋', desc: 'かざんのエネルギーを 体にためこんだ 大迫力の 炎竜戦士。' },
            { id: 'fire_power_7', level: 7, name: 'メテオドラゴン', emoji: '🐲', subEmoji: '☄️', desc: '空から いんせきのように まいおりる ちょうパワフルな ドラゴン！' },
            { id: 'fire_power_8', level: 8, name: 'ギガフレアタイタン', emoji: '👹', subEmoji: '🔥', desc: 'もえさかる よろいを まとった 炎のきょじん。だれにも まけぬちから！' },
            { id: 'fire_power_9', level: 9, name: 'カイザーマグマ竜', emoji: '🐉', subEmoji: '👑', desc: '大地を ゆるがす おたけびをあげる ほのおの こうていドラゴン！' },
            { id: 'fire_power_10', level: 10, name: 'ゴッドマグマレックス', emoji: '🐲', subEmoji: '👑🔥', desc: '【最終進化】たいようの ような さいきょうパワーをもつ 伝説の炎王竜！' }
          ],
          smart: [
            { id: 'fire_smart_5', level: 5, name: 'フレアウィザード', emoji: '🧙‍♂️', subEmoji: '🔥', desc: '【ちえルート】ほのおの まほうをつかいこなす かしこい モンスター。' },
            { id: 'fire_smart_6', level: 6, name: 'アークメイジ竜', emoji: '🦊', subEmoji: '✨', desc: 'あおい炎で まわりを ピカピカにする きれいで 頭脳派な 炎ぎつね。' },
            { id: 'fire_smart_7', level: 7, name: 'スターファイア賢者', emoji: '🦁', subEmoji: '🔮', desc: 'ほしぞらの 知恵を さずかった 気高い 炎のたてがみをもつ 賢者。' },
            { id: 'fire_smart_8', level: 8, name: 'ブルーノヴァ騎士', emoji: '🤺', subEmoji: '💠', desc: 'いちばん 温度の高い あおい炎のつるぎを ふるう クールな剣士！' },
            { id: 'fire_smart_9', level: 9, name: 'コスモフレア竜王', emoji: '🐉', subEmoji: '🌌', desc: 'うちゅうの ほのおを あやつる せいなる ドラゴンマスター。' },
            { id: 'fire_smart_10', level: 10, name: 'インフィニティフレア神', emoji: '🐲', subEmoji: '👑💠', desc: '【最終進化】ちえと ほのおの力を きわめた さいきょうの 炎神！' }
          ],
          kind: [
            { id: 'fire_kind_5', level: 5, name: 'サニーバード', emoji: '🐥', subEmoji: '☀️', desc: '【やさしさルート】みんなを ぽかぽか あたためる やさしい 炎の小鳥。' },
            { id: 'fire_kind_6', level: 6, name: 'ホーリーフェニックス', emoji: '🦅', subEmoji: '✨', desc: 'かがやく つばさで みんなを えがおにする 希望の 不死鳥！' },
            { id: 'fire_kind_7', level: 7, name: 'サンシャインペガサス', emoji: '🦄', subEmoji: '🌈', desc: 'にじいろの たてがみを もち 空を かける やさしい 炎のてんま。' },
            { id: 'fire_kind_8', level: 8, name: 'エンジェルフレイム', emoji: '🕊️', subEmoji: '💛', desc: 'おもいやりの 心に こたえて 進化した せいなる 炎の守護者。' },
            { id: 'fire_kind_9', level: 9, name: 'ソラリスドラゴン', emoji: '🐉', subEmoji: '☀️', desc: 'おひさまのように あたたかい 光をはなつ 黄金の やさしき竜。' },
            { id: 'fire_kind_10', level: 10, name: 'ゴッドサンフェニックス', emoji: '🦅', subEmoji: '👑☀️', desc: '【最終進化】せかいじゅうを あたたかい光で つつみこむ 伝説の太陽鳥！' }
