            { id: 'water_power_6', level: 6, name: 'メガロドンナイト', emoji: '🦈', subEmoji: '⚔️', desc: 'はがねの よろいを まとった 力じまんの 巨大サメ戦士！' },
            { id: 'water_power_7', level: 7, name: 'ストームホエール', emoji: '🐳', subEmoji: '🌪️', desc: 'おおきな 体で 大うなばらを まもる 力強い クジラ王。' },
            { id: 'water_power_8', level: 8, name: 'ポセイドンレックス', emoji: '🐊', subEmoji: '🔱', desc: 'うみの やりを もち どんな荒波も おさめる 水竜の勇者。' },
            { id: 'water_power_9', level: 9, name: 'アビスリヴァイアサン', emoji: '🐉', subEmoji: '🌊', desc: 'ふかい海の 底から めざめた 圧倒的パワーの 海竜！' },
