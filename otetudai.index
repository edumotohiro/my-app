            { id: 'water_kind_6', level: 6, name: 'レインボーオッター', emoji: '🦦', subEmoji: '🌈', desc: 'きれいな 川や海を まもる 気配りじょうずな かわうそ戦士。' },
            { id: 'water_kind_7', level: 7, name: 'アクアエンジェル', emoji: '🪼', subEmoji: '✨', desc: 'きらきら ひかる しずくで みんなを 元気にする 海のてんし。' },
            { id: 'water_kind_8', level: 8, name: 'マーメイドドラゴン', emoji: '🐉', subEmoji: '🐚', desc: 'うつくしい 歌声で みんなを 幸せにする やさしき水の竜。' },
            { id: 'water_kind_9', level: 9, name: 'ブレッシングホエール', emoji: '🐳', subEmoji: '💖', desc: 'おおきな やさしさで 仲間をつつみこむ せいなる 白クジラ。' },
            { id: 'water_kind_10', level: 10, name: 'ゴッドレインボードラゴン', emoji: '🐉', subEmoji: '👑🌈', desc: '【最終進化】あめあがりの 大きな虹をかける やさしさの 水神竜！' }
          ]
        }
      },

      // ---------------- 🌿 もり属性 ----------------
      forest: {
        common: [
          { id: 'forest_common_1', level: 1, name: 'もりのタマゴ', emoji: '🥚', subEmoji: '🌿', desc: 'あおい葉っぱの もようがついた 自然いっぱいの ふしぎなタマゴ。' },
          { id: 'forest_common_2', level: 2, name: 'タネピヨ', emoji: '🌱', subEmoji: '🐣', desc: 'タマゴから うまれたばかり！あたまの フタバが ぴょこぴょこ ゆれる。' },
          { id: 'forest_common_3', level: 3, name: 'リーフザウルス', emoji: '🦕', subEmoji: '🌿', desc: 'もりの なかを 元気に けんけんぱ！やさしい ちからもちの 小恐竜。' },
          { id: 'forest_common_4', level: 4, name: 'ウッドラプトル', emoji: '🦖', subEmoji: '🍃', desc: 'すばやく 走れるようになった！つぎの進化で すがたが大きくかわるぞ！' }
        ],
        branches: {
          power: [
            { id: 'forest_power_5', level: 5, name: 'ガイアトリケラ', emoji: '🦕', subEmoji: '🪨', desc: '【パワールート】3本の ツノで どんなものも おしとおす 大地の恐竜！' },
            { id: 'forest_power_6', level: 6, name: 'アイアンコング', emoji: '🦍', subEmoji: '🌿', desc: 'もりの へいわを まもる むきむき パワフルな 森の王者！' },
            { id: 'forest_power_7', level: 7, name: 'ロックブラキオ', emoji: '🦕', subEmoji: '⛰️', desc: 'やまのように 大きくて たくましい 超重量級の 草食竜！' },
            { id: 'forest_power_8', level: 8, name: 'ヘラクレスビートル', emoji: '🪲', subEmoji: '⚡', desc: 'おうごんの ツノをもつ こんちゅう界 さいきょうの パワー戦士！' },
            { id: 'forest_power_9', level: 9, name: 'ガイアティラノ竜', emoji: '🦖', subEmoji: '🌍', desc: 'だいちの パワーを すべてあつめた 大自然の こうてい恐竜！' },
            { id: 'forest_power_10', level: 10, name: 'ゴッドアースレックス', emoji: '🦖', subEmoji: '👑🌍', desc: '【最終進化】ちきゅうの 大地を 支える さいきょうの 恐竜王！' }
          ],
          smart: [
            { id: 'forest_smart_5', level: 5, name: 'フォレストオウル', emoji: '🦉', subEmoji: '🍃', desc: '【ちえルート】もりの ものしり博士！なんでも よく知っている フクロウ。' },
            { id: 'forest_smart_6', level: 6, name: 'リーフニンジャ', emoji: '🦊', subEmoji: '🍃', desc: 'このはがくれの じゅつを つかう すばしっこい 森の忍者！' },
            { id: 'forest_smart_7', level: 7, name: 'エメラルドスタッグ', emoji: '🦌', subEmoji: '✨', desc: 'きらめく 角をもつ かしこくて 気高い もりの 守護神。' },
            { id: 'forest_smart_8', level: 8, name: 'ドルイドドラゴン', emoji: '🐉', subEmoji: '🍀', desc: 'しぜんの 知恵と 風をあやつる せいなる 緑の竜賢者。' },
            { id: 'forest_smart_9', level: 9, name: 'クロノスツリー竜', emoji: '🐲', subEmoji: '🌟', desc: 'せんねんの たいじゅの 力を宿した 知恵の ドラゴンマスター。' },
            { id: 'forest_smart_10', level: 10, name: 'ユグドラシル神竜', emoji: '🐲', subEmoji: '👑🌳', desc: '【最終進化】せかいじゅの 知恵をもつ さいきょうの 森神ドラゴン！' }
          ],
          kind: [
            { id: 'forest_kind_5', level: 5, name: 'フラワーバニー', emoji: '🐰', subEmoji: '🌸', desc: '【やさしさルート】あるくと 足もとに お花がさく やさしい ウサギ。' },
            { id: 'forest_kind_6', level: 6, name: 'ハニーベア', emoji: '🐻', subEmoji: '🍯', desc: 'みんなに あまいハチミツを わけてくれる 心やさしい 森のクマさん。' },
            { id: 'forest_kind_7', level: 7, name: 'フェアリーユニコーン', emoji: '🦄', subEmoji: '🌺', desc: '花畑を かけめぐる ようせいたちの リーダー！とっても やさしい。' },
            { id: 'forest_kind_8', level: 8, name: 'ガーディアンパンダ', emoji: '🐼', subEmoji: '🎋', desc: 'ちいさな 生きものたちを いつも 見守る やさしい 森の守り神。' },
            { id: 'forest_kind_9', level: 9, name: 'エデンブルーム竜', emoji: '🐉', subEmoji: '🌸', desc: 'せかいじゅうに きれいな花を さかせる やさしさの 緑竜！' },
            { id: 'forest_kind_10', level: 10, name: 'ゴッドフラワードラゴン', emoji: '🐉', subEmoji: '👑🌸', desc: '【最終進化】やさしさの 花で せかいを いっぱいにする 伝説の花竜王！' }
          ]
        }
      }
    };

    /* =========================================================================
       3. アプリ状態管理 & LocalStorage 永続化
       ========================================================================= */
    const STORAGE_KEY = 'otetsudai_monsters_v2';

    const DEFAULT_CHORES = [
      { id: 'c1', name: 'おふろそうじ', pt: 3, cat: 'power', icon: '🛁' },
      { id: 'c2', name: 'ゴミだし', pt: 2, cat: 'power', icon: '🗑️' },
      { id: 'c3', name: 'くつならべ', pt: 1, cat: 'power', icon: '👟' },
      { id: 'c4', name: 'しょっきあらい', pt: 2, cat: 'smart', icon: '🍽️' },
      { id: 'c5', name: 'せんたくものたたみ', pt: 2, cat: 'smart', icon: '👕' },
      { id: 'c6', name: 'あしたのじゅんび', pt: 2, cat: 'smart', icon: '🎒' },
      { id: 'c7', name: 'ごはんのじゅんび', pt: 2, cat: 'kind', icon: '🥢' },
      { id: 'c8', name: 'おせわ・おもいやり', pt: 2, cat: 'kind', icon: '💖' }
    ];

    const DEFAULT_REWARDS = [
      { id: 'r1', name: 'すきなおやつ 1こ', cost: 8, icon: '🍨' },
      { id: 'r2', name: 'ゲーム 30ぷん', cost: 10, icon: '🎮' },
      { id: 'r3', name: '夜ふかし 15ぷん', cost: 12, icon: '🌙' },
      { id: 'r4', name: 'おこづかい 100えん', cost: 15, icon: '🪙' }
    ];

    let appState = {
      usablePoints: 0,
      totalPoints: 0,
      cycleCount: 1, // 何周目か
      activePartner: null, // { attr: 'fire'|'water'|'forest', expPt: 0, catPts: { power: 0, smart: 0, kind: 0 }, lockedBranch: null }
      unlockedIds: [], // 図鑑登録済みモンスターID配列
      hallOfFame: [], // 殿堂入り記録 [ { monsterId, name, attr, branch, cycle, dateStr } ]
      chores: [],
      rewards: [],
      logs: {},
      rewardHistory: [],
      muted: false
    };

    let currentCalYear = new Date().getFullYear();
    let currentCalMonth = new Date().getMonth();
    let selectedDetailDate = null;
    let currentChoreFilter = 'all';
    let currentZukanAttr = 'fire';

    function getTodayStr() {
      const d = new Date();
      return formatDateStr(d.getFullYear(), d.getMonth() + 1, d.getDate());
    }

    function formatDateStr(y, m, d) {
      return `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          appState = {
            usablePoints: Number(p.usablePoints) || 0,
            totalPoints: Number(p.totalPoints) || 0,
            cycleCount: Number(p.cycleCount) || 1,
            activePartner: p.activePartner || null,
            unlockedIds: Array.isArray(p.unlockedIds) ? p.unlockedIds : [],
            hallOfFame: Array.isArray(p.hallOfFame) ? p.hallOfFame : [],
            chores: Array.isArray(p.chores) && p.chores.length > 0 ? p.chores : [...DEFAULT_CHORES],
            rewards: Array.isArray(p.rewards) && p.rewards.length > 0 ? p.rewards : [...DEFAULT_REWARDS],
            logs: p.logs || {},
            rewardHistory: p.rewardHistory || [],
            muted: Boolean(p.muted)
          };
        } else {
          appState.chores = [...DEFAULT_CHORES];
          appState.rewards = [...DEFAULT_REWARDS];
        }
      } catch (e) {
        console.error('Load failed:', e);
        appState.chores = [...DEFAULT_CHORES];
        appState.rewards = [...DEFAULT_REWARDS];
      }
      SoundFX.muted = appState.muted;
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        console.error('Save failed:', e);
      }
    }

    /* =========================================================================
       4. パートナー育成・ルート分岐・ビジュアル生成ロジック
       ========================================================================= */
    function getLevelFromExp(expPt) {
      let lv = 1;
      for (const item of LEVEL_THRESHOLDS) {
        if (expPt >= item.minPt) lv = item.level;
      }
      return lv;
    }

    function getDominantCategory(catPts) {
      const { power = 0, smart = 0, kind = 0 } = catPts;
      if (power >= smart && power >= kind) return 'power';
      if (smart >= power && smart >= kind) return 'smart';
      return 'kind';
    }

    function getCurrentMonsterData(partner) {
      if (!partner) return null;
      const attr = partner.attr || 'fire';
      const lv = getLevelFromExp(partner.expPt);
      const db = MONSTER_DB[attr];

      if (lv <= 4) {
        return db.common[lv - 1];
      } else {
        const branch = partner.lockedBranch || getDominantCategory(partner.catPts);
        return db.branches[branch][lv - 5];
      }
    }

    function unlockMonsterInZukan(monsterId) {
      if (monsterId && !appState.unlockedIds.includes(monsterId)) {
        appState.unlockedIds.push(monsterId);
      }
    }

    // カスタムSVG＋絵文字を融合したリッチなモンスターカードグラフィック生成
    function buildMonsterVisualHTML(monster, attr, level, isSilhouette = false) {
      const meta = ATTR_META[attr] || ATTR_META.fire;
      const filterStyle = isSilhouette ? 'filter: brightness(0) opacity(0.28);' : '';
      const scale = 0.78 + (level * 0.025); // レベルが高いほど大きく迫力が出る

      return `
        <div class="relative w-full h-full flex items-center justify-center" style="${filterStyle}">
          <svg viewBox="0 0 160 160" class="w-full h-full drop-shadow-md">
            <!-- ベースサークル -->
            <circle cx="80" cy="84" r="62" fill="#FFFFFF" stroke="#1E293B" stroke-width="5"/>
            <circle cx="80" cy="84" r="52" fill="${meta.auraColor}" fill-opacity="0.18"/>
            <!-- レベルに応じた装飾（翼・王冠・輝き） -->
            ${level >= 5 ? `<path d="M22 72 L4 48 L16 86 Z M138 72 L156 48 L144 86 Z" fill="${meta.auraColor}" stroke="#1E293B" stroke-width="3.5" stroke-linejoin="round"/>` : ''}
            ${level >= 8 ? `<polygon points="56,26 66,10 80,22 94,10 104,26" fill="#FACC15" stroke="#1E293B" stroke-width="3.5" stroke-linejoin="round"/>` : ''}
            ${level === 10 ? `<circle cx="80" cy="84" r="70" fill="none" stroke="#FACC15" stroke-width="4" stroke-dasharray="10 6"/>` : ''}
          </svg>
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none" style="transform: scale(${scale});">
            <span class="text-6xl sm:text-7xl drop-shadow-[0_4px_2px_rgba(0,0,0,0.2)]">${monster.emoji}</span>
          </div>
          ${!isSilhouette && monster.subEmoji ? `
            <span class="absolute bottom-1 right-1 bg-white border-2 border-slate-900 rounded-full px-1.5 py-0.5 text-sm sm:text-base shadow">
              ${monster.subEmoji}
            </span>
          ` : ''}
        </div>
      `;
    }

    function buildAuraSVG(attr, level) {
      const meta = ATTR_META[attr] || ATTR_META.fire;
      if (level < 3) return '';
      return `
        <svg viewBox="0 0 200 200" class="w-full h-full aura-spin">
          <polygon points="100,6 122,42 164,28 154,70 192,92 158,120 176,160 134,156 118,194 92,162 56,184 54,142 14,140 36,104 12,70 54,62 56,20 88,42"
            fill="${meta.auraColor}" fill-opacity="0.22" stroke="${meta.ringColor}" stroke-width="2" stroke-dasharray="6 6"/>
        </svg>
      `;
    }

    // パートナー選択実行
    window.selectStarterEgg = function(attr) {
      appState.activePartner = {
        attr,
        expPt: 0,
        catPts: { power: 0, smart: 0, kind: 0 },
        lockedBranch: null
      };
      const firstMonster = MONSTER_DB[attr].common[0];
      unlockMonsterInZukan(firstMonster.id);
      saveState();

      closeModal('modal-egg-select');
      SoundFX.playCoin();
      updateAllUI();
      showToast(`${firstMonster.name} と いっしょに ぼうけんスタート！`);
    };

    function renderMonsterStage() {
      const p = appState.activePartner;
      if (!p) {
        openModal('modal-egg-select');
        return;
      }

      const lv = getLevelFromExp(p.expPt);
      const monster = getCurrentMonsterData(p);
      const attrMeta = ATTR_META[p.attr];

      // 背景グラデーション更新
      const card = document.getElementById('monster-stage-card');
      card.className = `game-box-lg rounded-3xl p-4 mb-5 bg-gradient-to-b ${attrMeta.cardGradient} relative overflow-hidden`;

      document.getElementById('cycle-badge').textContent = `${appState.cycleCount}しゅうめ`;
      document.getElementById('monster-level-badge').textContent = `Lv.${lv} / 10`;

      const typeBadge = document.getElementById('monster-type-badge');
      typeBadge.textContent = attrMeta.label;
      typeBadge.className = `${attrMeta.badgeBg} text-xs font-black px-2.5 py-1 rounded-full border-2 border-slate-900`;

      const routeBadge = document.getElementById('monster-route-badge');
      if (lv >= 5 && p.lockedBranch) {
        const bMeta = BRANCH_META[p.lockedBranch];
        routeBadge.textContent = bMeta.label;
        routeBadge.className = `bg-white ${bMeta.color} text-xs font-black px-2.5 py-1 rounded-full border-2 border-slate-900`;
      } else {
        routeBadge.textContent = '🌱 せいちょう中（Lv.5で分岐）';
        routeBadge.className = 'bg-white/90 text-slate-800 text-xs font-extrabold px-2.5 py-1 rounded-full border-2 border-slate-900';
      }

      document.getElementById('monster-aura-bg').innerHTML = buildAuraSVG(p.attr, lv);
      document.getElementById('monster-visual-container').innerHTML = buildMonsterVisualHTML(monster, p.attr, lv, false);
      document.getElementById('monster-name').textContent = monster.name;
      document.getElementById('monster-speech').innerHTML = monster.desc;

      // 経験値ゲージ
      const nextThreshold = LEVEL_THRESHOLDS.find(t => t.level === lv + 1);
      const currentThreshold = LEVEL_THRESHOLDS.find(t => t.level === lv);
      const barFill = document.getElementById('exp-bar-fill');
      const remText = document.getElementById('exp-remaining-text');
      const stageLabel = document.getElementById('exp-stage-label');
      const nextEggCta = document.getElementById('next-egg-cta');

      if (nextThreshold) {
        const span = nextThreshold.minPt - currentThreshold.minPt;
        const gained = p.expPt - currentThreshold.minPt;
        const pct = Math.min(100, Math.max(0, (gained / span) * 100));
        const rem = nextThreshold.minPt - p.expPt;

        stageLabel.innerHTML = lv === 4 ? `つぎは <span class="text-orange-600 font-black">ルート分岐進化！</span>` : `つぎのレベル（Lv.${lv + 1}）まで`;
        remText.textContent = `あと ${rem} pt！`;
        barFill.style.width = `${pct}%`;
        nextEggCta.classList.add('hidden');
      } else {
        stageLabel.textContent = 'さいこうレベル達成！でんどういり！';
        remText.textContent = 'Lv.10 MAX！';
        barFill.style.width = '100%';
        nextEggCta.classList.remove('hidden');
      }

      // タイプ別バランスバー描画
      const { power = 0, smart = 0, kind = 0 } = p.catPts;
      const sumCat = power + smart + kind;
      document.getElementById('tendency-total-pt').textContent = `いくせい ${p.expPt} pt`;
      document.getElementById('pt-power').textContent = power;
      document.getElementById('pt-smart').textContent = smart;
      document.getElementById('pt-kind').textContent = kind;

      if (sumCat === 0) {
        document.getElementById('bar-power').style.width = '33.3%';
        document.getElementById('bar-smart').style.width = '33.4%';
        document.getElementById('bar-kind').style.width = '33.3%';
      } else {
        document.getElementById('bar-power').style.width = `${(power / sumCat) * 100}%`;
        document.getElementById('bar-smart').style.width = `${(smart / sumCat) * 100}%`;
        document.getElementById('bar-kind').style.width = `${(kind / sumCat) * 100}%`;
      }

      // 分岐ヒント表示
      const hintBox = document.getElementById('branch-hint-box');
      if (lv < 5) {
        if (sumCat === 0) {
          hintBox.innerHTML = `💡 Lv.5になると おおいタイプによって <b>3つのルート</b> に <ruby>進化<rt>しんか</rt></ruby>がわかれるよ！`;
        } else {
          const dom = getDominantCategory(p.catPts);
          const bMeta = BRANCH_META[dom];
          const futureLv5 = MONSTER_DB[p.attr].branches[dom][0];
          hintBox.innerHTML = `🔮 いまは <span class="${bMeta.color} font-black">【${bMeta.short}】</span> がトップ！このままだと <b>「${futureLv5.name}」</b> ルートに なりそう！`;
        }
      } else {
        const bMeta = BRANCH_META[p.lockedBranch || 'power'];
        hintBox.innerHTML = `✨ <span class="${bMeta.color} font-black">${bMeta.label}</span> に 決定！Lv.10の 最終進化をめざそう！`;
      }
    }

    /* =========================================================================
       5. お手伝い記録＆進化判定
       ========================================================================= */
    function addChoreRecord(choreId, dateStr = getTodayStr(), eventObj = null) {
      const chore = appState.chores.find(c => c.id === choreId);
      if (!chore || !appState.activePartner) return;

      const p = appState.activePartner;
      const prevLv = getLevelFromExp(p.expPt);
      const cat = chore.cat || 'power';

      // ポイント＆経験値加算
      appState.usablePoints += chore.pt;
      appState.totalPoints += chore.pt;
      p.expPt += chore.pt;
      p.catPts[cat] = (p.catPts[cat] || 0) + chore.pt;

      // ログ保存
      if (!appState.logs[dateStr]) appState.logs[dateStr] = [];
      appState.logs[dateStr].push({
        uid: 'log_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        choreId: chore.id,
        name: chore.name,
        pt: chore.pt,
        cat,
        icon: chore.icon
      });

      const newLv = getLevelFromExp(p.expPt);
      let branchedNow = false;

      // Lv.5到達時にルート確定
      if (newLv >= 5 && !p.lockedBranch) {
        p.lockedBranch = getDominantCategory(p.catPts);
        branchedNow = true;
      }

      const newMonster = getCurrentMonsterData(p);
      unlockMonsterInZukan(newMonster.id);

      // Lv.10（殿堂入り）初到達チェック
      let reachedHallOfFame = false;
      if (prevLv < 10 && newLv === 10) {
        reachedHallOfFame = true;
        appState.hallOfFame.push({
          monsterId: newMonster.id,
          name: newMonster.name,
          emoji: newMonster.emoji,
          attr: p.attr,
          branch: p.lockedBranch || 'power',
          cycle: appState.cycleCount,
          dateStr: getTodayStr()
        });
      }

      saveState();
      updateAllUI();

      // エフェクト
      SoundFX.playCoin();
      bounceMonster();

      if (eventObj) {
        const rect = eventObj.currentTarget.getBoundingClientRect();
        spawnFloatingPt(`+${chore.pt}pt!`, rect.left + rect.width / 2, rect.top);
      } else {
        showToast(`${chore.icon} ${chore.name} (+${chore.pt}pt) をきろくしたよ！`);
      }

      // レベルアップ・進化モーダル表示
      if (newLv > prevLv) {
        setTimeout(() => showEvolutionModal(newMonster, p.attr, newLv, branchedNow, reachedHallOfFame), 420);
      }
    }

    function showEvolutionModal(monster, attr, lv, branchedNow, isHallOfFame) {
      SoundFX.playFanfare();
      launchConfetti(isHallOfFame ? 4000 : 2600);

      const badgeTop = document.getElementById('evo-badge-top');
      const title = document.getElementById('evo-title');
      const branchNotice = document.getElementById('evo-branch-notice');
      const actionArea = document.getElementById('evo-action-buttons');

      if (isHallOfFame) {
        badgeTop.textContent = '👑 最終進化＆でんどういり！ 👑';
        title.textContent = `「${monster.name}」が かんせいした！`;
      } else if (lv === 2) {
        badgeTop.textContent = '🐣 たんじょう！ 🐣';
        title.textContent = 'タマゴから うまれたよ！';
      } else {
        badgeTop.textContent = `🎉 Lv.${lv} に 進化！ 🎉`;
        title.textContent = `「${monster.name}」に 進化した！`;
      }

      if (branchedNow && appState.activePartner?.lockedBranch) {
        const bMeta = BRANCH_META[appState.activePartner.lockedBranch];
        branchNotice.textContent = `✨ おてつだいの傾向から【${bMeta.label}】に 進化がわかれたぞ！`;
        branchNotice.classList.remove('hidden');
      } else {
        branchNotice.classList.add('hidden');
      }

      document.getElementById('evo-visual-box').innerHTML = buildMonsterVisualHTML(monster, attr, lv, false);
      document.getElementById('evo-monster-name').textContent = `Lv.${lv} ${monster.name}`;
      document.getElementById('evo-monster-desc').textContent = monster.desc;

      if (isHallOfFame) {
        actionArea.innerHTML = `
          <button type="button" onclick="startNextCycleEgg()" class="game-btn w-full bg-gradient-to-r from-yellow-400 to-orange-400 text-slate-900 font-black py-3 rounded-2xl text-base">
            🥚 あたらしいタマゴを えらぶ！（${appState.cycleCount + 1}しゅうめへ）
          </button>
          <button type="button" onclick="closeModal('modal-evolution')" class="game-btn w-full bg-slate-200 text-slate-800 font-black py-2 rounded-2xl text-xs">
            いまのモンスターを もうすこし見る
          </button>
        `;
      } else {
        actionArea.innerHTML = `
          <button type="button" onclick="closeModal('modal-evolution')" class="game-btn w-full bg-green-500 text-white font-black py-3 rounded-2xl text-base">
            やったー！つづける
          </button>
        `;
      }

      openModal('modal-evolution');
    }

    window.startNextCycleEgg = function() {
      closeModal('modal-evolution');
      appState.cycleCount += 1;
      appState.activePartner = null;
      saveState();
      openModal('modal-egg-select');
    };

    function removeChoreRecord(dateStr, logUid) {
      const dayLogs = appState.logs[dateStr];
      if (!dayLogs) return;

      const idx = dayLogs.findIndex(item => item.uid === logUid);
      if (idx === -1) return;

      const target = dayLogs[idx];
      dayLogs.splice(idx, 1);
      if (dayLogs.length === 0) delete appState.logs[dateStr];

      appState.usablePoints = Math.max(0, appState.usablePoints - target.pt);
      appState.totalPoints = Math.max(0, appState.totalPoints - target.pt);

      if (appState.activePartner) {
        const p = appState.activePartner;
        p.expPt = Math.max(0, p.expPt - target.pt);
        const cat = target.cat || 'power';
        p.catPts[cat] = Math.max(0, (p.catPts[cat] || 0) - target.pt);
        if (getLevelFromExp(p.expPt) < 5) {
          p.lockedBranch = null;
        }
      }

      saveState();
      SoundFX.playCancel();
      updateAllUI();
      showToast(`「${target.name}」を とりけしました`);

      if (selectedDetailDate === dateStr) {
        renderDayDetailModal(dateStr);
      }
    }

    function bounceMonster() {
      const el = document.getElementById('monster-visual-container');
      el.classList.remove('monster-jump');
      void el.offsetWidth;
      el.classList.add('monster-jump');
    }

    function spawnFloatingPt(text, x, y) {
      const el = document.createElement('div');
      el.className = 'floating-pt';
      el.textContent = text;
      el.style.left = `${Math.min(window.innerWidth - 90, Math.max(10, x - 35))}px`;
      el.style.top = `${Math.max(60, y)}px`;
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 1000);
    }

    /* =========================================================================
       6. 各タブ画面描画（お手伝い・カレンダー・ごほうび・図鑑）
       ========================================================================= */
    function updateAllUI() {
      document.getElementById('usable-points').textContent = appState.usablePoints;
      document.getElementById('total-points').textContent = appState.totalPoints;

      renderMonsterStage();
      renderChoresTab();
      renderCalendar();
      renderRewardsTab();
      renderZukanTab();
    }

    function renderChoresTab() {
      const todayStr = getTodayStr();
      const d = new Date();
      const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
      document.getElementById('today-date-label').textContent =
        `${d.getMonth() + 1}月${d.getDate()}日(${weekdays[d.getDay()]})`;

      const todayLogs = appState.logs[todayStr] || [];
      const counts = {};
      todayLogs.forEach(item => {
        counts[item.choreId] = (counts[item.choreId] || 0) + 1;
      });

      const grid = document.getElementById('chore-list-grid');
      grid.innerHTML = '';

      const filteredChores = currentChoreFilter === 'all'
        ? appState.chores
        : appState.chores.filter(c => (c.cat || 'power') === currentChoreFilter);

      filteredChores.forEach(chore => {
        const count = counts[chore.id] || 0;
        const cat = chore.cat || 'power';
        const catTag = cat === 'power'
          ? { text: '🔥パワー', cls: 'bg-red-100 text-red-700 border-red-300' }
          : cat === 'smart'
          ? { text: '💧ちえ', cls: 'bg-blue-100 text-blue-700 border-blue-300' }
          : { text: '🌿やさしさ', cls: 'bg-green-100 text-green-700 border-green-300' };

        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'game-btn bg-white rounded-2xl p-3 flex flex-col items-center text-center relative active:bg-yellow-100';
        card.innerHTML = `
          ${count > 0 ? `<span class="absolute -top-2 -right-2 bg-green-500 text-white border-2 border-slate-900 rounded-full text-[11px] font-black px-2 py-0.5 shadow">今日 ${count}回</span>` : ''}
          <span class="text-[10px] font-black px-2 py-0.5 rounded-full border ${catTag.cls} mb-1">${catTag.text}</span>
          <div class="text-4xl my-1">${chore.icon}</div>
          <div class="text-xs sm:text-sm font-black text-slate-900 leading-snug mb-2">${escapeHTML(chore.name)}</div>
          <div class="mt-auto bg-orange-500 text-white text-xs sm:text-sm font-black px-3 py-0.5 rounded-full border-2 border-slate-900">
            +${chore.pt} pt
          </div>
        `;
        card.addEventListener('click', (e) => addChoreRecord(chore.id, todayStr, e));
        grid.appendChild(card);
      });

      // 今日の記録
      const logContainer = document.getElementById('today-log-list');
      const sumPt = todayLogs.reduce((acc, cur) => acc + cur.pt, 0);
      document.getElementById('today-earned-sum').textContent = `合計 ${sumPt} pt`;

      if (todayLogs.length === 0) {
        logContainer.innerHTML = `<div class="text-slate-500 text-xs sm:text-sm font-bold text-center py-3">まだ きろくがありません。上のボタンを押してみよう！</div>`;
      } else {
        logContainer.innerHTML = todayLogs.slice().reverse().map(item => `
          <div class="flex items-center justify-between py-2">
            <div class="flex items-center gap-2 font-extrabold text-xs sm:text-sm">
              <span class="text-xl">${item.icon}</span>
              <span>${escapeHTML(item.name)}</span>
              <span class="text-orange-600">(+${item.pt}pt)</span>
            </div>
            <button type="button" onclick="removeChoreRecord('${todayStr}', '${item.uid}')" class="bg-red-100 text-red-700 border-2 border-red-400 rounded-xl px-2.5 py-1 text-xs font-black active:bg-red-200">
              とりけす
            </button>
          </div>
        `).join('');
      }
    }

    function renderCalendar() {
      document.getElementById('cal-month-title').textContent = `${currentCalYear}年 ${currentCalMonth + 1}月`;
      const grid = document.getElementById('cal-grid');
      grid.innerHTML = '';

      const firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const todayStr = getTodayStr();

      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('div');
        grid.appendChild(empty);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = formatDateStr(currentCalYear, currentCalMonth + 1, day);
        const dow = new Date(currentCalYear, currentCalMonth, day).getDay();
        const logs = appState.logs[dateStr] || [];
        const dayPt = logs.reduce((s, x) => s + x.pt, 0);

        const cell = document.createElement('button');
        cell.type = 'button';
        let bgCls = dayPt > 0 ? 'bg-yellow-100 border-yellow-500' : 'bg-slate-50 border-slate-300';
        if (dateStr === todayStr) bgCls += ' ring-2 ring-orange-500';

        const numColor = dow === 0 ? 'text-red-500' : dow === 6 ? 'text-blue-500' : 'text-slate-800';

        cell.className = `aspect-[1/1.2] border-2 ${bgCls} rounded-xl p-1 flex flex-col items-center justify-between active:scale-95 transition`;
        cell.innerHTML = `
          <span class="text-xs font-black ${numColor}">${day}</span>
          <span class="text-sm leading-none">${dayPt > 0 ? '⭐' : ''}</span>
          ${dayPt > 0 ? `<span class="bg-green-500 text-white text-[10px] font-black px-1.5 rounded-full">+${dayPt}</span>` : '<span class="h-3.5"></span>'}
        `;

        cell.addEventListener('click', () => {
          selectedDetailDate = dateStr;
          renderDayDetailModal(dateStr);
          openModal('modal-day-detail');
        });

        grid.appendChild(cell);
      }
    }

    function renderDayDetailModal(dateStr) {
      const [y, m, d] = dateStr.split('-').map(Number);
      document.getElementById('day-detail-title').textContent = `${y}年${m}月${d}日のきろく`;

      const logs = appState.logs[dateStr] || [];
      const logsEl = document.getElementById('day-detail-logs');

      if (logs.length === 0) {
        logsEl.innerHTML = `<div class="text-center text-slate-500 text-xs sm:text-sm font-bold py-3">この日のきろくはありません</div>`;
      } else {
        logsEl.innerHTML = logs.map(item => `
          <div class="flex items-center justify-between py-2">
            <div class="flex items-center gap-2 text-xs sm:text-sm font-extrabold">
              <span class="text-lg">${item.icon}</span>
              <span>${escapeHTML(item.name)} (+${item.pt}pt)</span>
            </div>
            <button type="button" onclick="removeChoreRecord('${dateStr}', '${item.uid}')" class="bg-red-100 text-red-700 border border-red-400 rounded-lg px-2 py-0.5 text-xs font-black">
              さくじょ
            </button>
          </div>
        `).join('');
      }

      const addBtnsEl = document.getElementById('day-detail-add-btns');
      addBtnsEl.innerHTML = appState.chores.map(c => `
        <button type="button" onclick="addChoreRecord('${c.id}', '${dateStr}'); renderDayDetailModal('${dateStr}');" class="bg-amber-50 border-2 border-slate-900 rounded-xl px-2.5 py-1 text-xs font-black active:bg-amber-200">
          ${c.icon} ${escapeHTML(c.name)} (+${c.pt}pt)
        </button>
      `).join('');
    }

    function renderRewardsTab() {
      const grid = document.getElementById('reward-list-grid');
      grid.innerHTML = '';

      appState.rewards.forEach(reward => {
        const canAfford = appState.usablePoints >= reward.cost;
        const card = document.createElement('div');
        card.className = 'game-box bg-gradient-to-b from-white to-yellow-50 rounded-2xl p-3 flex flex-col items-center text-center';
        card.innerHTML = `
          <div class="text-4xl my-1">${reward.icon}</div>
          <div class="text-xs sm:text-sm font-black text-slate-900 mb-2.5 leading-snug">${escapeHTML(reward.name)}</div>
          <button type="button" ${canAfford ? '' : 'disabled'} class="game-btn w-full ${canAfford ? 'bg-yellow-400 text-slate-900' : 'bg-slate-200 text-slate-500'} font-black py-2 px-2 rounded-xl text-xs mt-auto">
            ${canAfford ? `✨ ${reward.cost}pt でこうかん` : `あと ${reward.cost - appState.usablePoints}pt`}
          </button>
        `;
        if (canAfford) {
          card.querySelector('button').addEventListener('click', () => openRewardConfirm(reward));
        }
        grid.appendChild(card);
      });

      const histEl = document.getElementById('reward-history-list');
      if (appState.rewardHistory.length === 0) {
        histEl.innerHTML = `<div class="text-slate-500 text-xs sm:text-sm font-bold text-center py-3">まだ こうかんした ごほうびはありません</div>`;
      } else {
        histEl.innerHTML = appState.rewardHistory.slice().reverse().slice(0, 15).map(h => `
          <div class="flex items-center justify-between py-2">
            <div class="flex items-center gap-2">
              <span class="text-2xl">${h.icon}</span>
              <div>
                <div class="text-xs sm:text-sm font-black">${escapeHTML(h.name)}</div>
                <div class="text-[11px] font-bold text-slate-500">${h.dateStr} (${h.cost}pt)</div>
              </div>
            </div>
            <span class="bg-green-100 text-green-700 border border-green-400 px-2 py-0.5 rounded-lg text-[11px] font-black">ゲット済</span>
          </div>
        `).join('');
      }
    }

    function openRewardConfirm(reward) {
      document.getElementById('reward-modal-title').innerHTML = `ごほうびと <ruby>交換<rt>こうかん</rt></ruby>する？`;
      document.getElementById('reward-modal-body').innerHTML = `
        <div class="text-5xl my-2">${reward.icon}</div>
        <div class="text-lg font-black mb-1">${escapeHTML(reward.name)}</div>
        <p class="text-xs sm:text-sm font-extrabold text-orange-600 mb-4">
          つかえるポイントを ${reward.cost}pt つかいます。<br>
          <span class="text-slate-500 text-xs">（※るいけいポイントと モンスターのレベルは へりません）</span>
        </p>
        <div class="flex gap-2">
          <button type="button" onclick="closeModal('modal-reward-confirm')" class="game-btn flex-1 bg-slate-200 font-black py-2.5 rounded-2xl">やめる</button>
          <button type="button" id="confirm-exchange-exec-btn" class="game-btn flex-1 bg-green-500 text-white font-black py-2.5 rounded-2xl">こうかんする！</button>
        </div>
      `;
      openModal('modal-reward-confirm');

      document.getElementById('confirm-exchange-exec-btn').onclick = () => {
        if (appState.usablePoints < reward.cost) return;
        appState.usablePoints -= reward.cost;
        appState.rewardHistory.push({
          uid: 'rew_' + Date.now(),
          name: reward.name,
          cost: reward.cost,
          icon: reward.icon,
          dateStr: getTodayStr()
        });
        saveState();
        updateAllUI();

        SoundFX.playFanfare();
        launchConfetti(2600);

        document.getElementById('reward-modal-title').textContent = '🎉 ごほうびチケット獲得！';
        document.getElementById('reward-modal-body').innerHTML = `
          <div class="ticket-pattern border-4 border-dashed border-slate-900 rounded-2xl p-4 my-3">
            <div class="text-xs font-black mb-1">★ ごほうびチケット ★</div>
            <div class="text-5xl my-1">${reward.icon}</div>
            <div class="text-lg font-black">${escapeHTML(reward.name)}</div>
          </div>
          <p class="text-xs sm:text-sm font-extrabold mb-3">おうちのひとに この画面を みせてね！</p>
          <button type="button" onclick="closeModal('modal-reward-confirm')" class="game-btn w-full bg-green-500 text-white font-black py-3 rounded-2xl">
            やったー！とじる
          </button>
        `;
      };
    }

    function renderZukanTab() {
      // 全39種類中の発見数カウント
      document.getElementById('zukan-progress-badge').textContent = `発見数: ${appState.unlockedIds.length} / 39`;

      // 殿堂入りリスト
      const hofEl = document.getElementById('hall-of-fame-list');
      document.getElementById('hof-count').textContent = `${appState.hallOfFame.length}ひき`;

      if (appState.hallOfFame.length === 0) {
        hofEl.innerHTML = `<div class="text-xs font-bold text-amber-800/75 py-2">Lv.10（最終進化）まで そだてると ここに 殿堂入りパートナーが ならぶよ！</div>`;
      } else {
        hofEl.innerHTML = appState.hallOfFame.map(h => `
          <div class="shrink-0 bg-white border-2 border-slate-900 rounded-2xl p-2 text-center w-24 shadow-sm">
            <div class="text-[10px] font-black bg-yellow-300 rounded-full mb-1">${h.cycle}しゅうめ</div>
            <div class="text-3xl my-0.5">${h.emoji}</div>
            <div class="text-[11px] font-black leading-tight truncate">${escapeHTML(h.name)}</div>
          </div>
        `).join('');
      }

      // 選択中の属性の図鑑（共通Lv1〜4 ＋ 3分岐Lv5〜10）
      const db = MONSTER_DB[currentZukanAttr];
      const container = document.getElementById('zukan-content-area');

      const renderCard = (m, routeName) => {
        const unlocked = appState.unlockedIds.includes(m.id);
        return `
          <button type="button" ${unlocked ? `onclick="openZukanDetail('${m.id}', '${currentZukanAttr}', '${routeName}')"` : ''}
            class="border-2 border-slate-900 rounded-2xl p-2 text-center ${unlocked ? 'bg-white shadow-[0_3px_0_#0f172a] active:translate-y-0.5' : 'bg-slate-200/80 opacity-80'}">
            <div class="text-[10px] font-black text-slate-600 mb-0.5">Lv.${m.level}</div>
            <div class="w-16 h-16 mx-auto">
              ${buildMonsterVisualHTML(m, currentZukanAttr, m.level, !unlocked)}
            </div>
            <div class="text-[11px] font-black mt-1 truncate ${unlocked ? 'text-slate-900' : 'text-slate-500'}">
              ${unlocked ? m.name : '？？？'}
            </div>
          </button>
        `;
      };

      container.innerHTML = `
        <div class="game-box bg-white rounded-2xl p-3">
          <div class="text-xs sm:text-sm font-black mb-2 text-slate-800">🌱 ようねん期・せいちょう期（Lv.1 〜 Lv.4）</div>
          <div class="grid grid-cols-4 gap-2">
            ${db.common.map(m => renderCard(m, '共通せいちょう期')).join('')}
          </div>
        </div>

        ${['power', 'smart', 'kind'].map(bKey => {
          const bMeta = BRANCH_META[bKey];
          return `
            <div class="game-box bg-white rounded-2xl p-3">
              <div class="text-xs sm:text-sm font-black mb-2 ${bMeta.color}">
                ${bMeta.label}（Lv.5 〜 Lv.10 最終進化）
              </div>
              <div class="grid grid-cols-3 gap-2">
                ${db.branches[bKey].map(m => renderCard(m, bMeta.label)).join('')}
              </div>
            </div>
          `;
        }).join('')}
      `;
    }

    window.openZukanDetail = function(monsterId, attr, routeName) {
      const db = MONSTER_DB[attr];
      const all = [...db.common, ...db.branches.power, ...db.branches.smart, ...db.branches.kind];
      const m = all.find(x => x.id === monsterId);
      if (!m) return;

      document.getElementById('zd-level-badge').textContent = `Lv.${m.level} / ${ATTR_META[attr].label}`;
      document.getElementById('zd-visual-box').innerHTML = buildMonsterVisualHTML(m, attr, m.level, false);
      document.getElementById('zd-name').textContent = m.name;
      document.getElementById('zd-route-tag').textContent = routeName;
      document.getElementById('zd-desc').textContent = m.desc;
      openModal('modal-zukan-detail');
    };

    /* =========================================================================
       7. 保護者設定（追加・編集・削除・初期化）
       ========================================================================= */
    const CHORE_EMOJIS = ['🛁', '🗑️', '👟', '🍽️', '👕', '🎒', '🥢', '💖', '🧹', '🪴', '🐶', '📚'];
    const REWARD_EMOJIS = ['🍨', '🎮', '🌙', '🪙', '🍫', '📺', '🎡', '📖', '⚽', '🎁', '🍰', '🎟️'];

    let selectedChoreEmoji = CHORE_EMOJIS[0];
    let selectedRewardEmoji = REWARD_EMOJIS[0];
    let gateExpectedAnswer = 0;

    function openParentGate() {
      const a = Math.floor(Math.random() * 6) + 4;
      const b = Math.floor(Math.random() * 6) + 4;
      gateExpectedAnswer = a * b;
      document.getElementById('gate-question').textContent = `${a} × ${b} = ？`;
      document.getElementById('gate-answer-input').value = '';
      openModal('modal-parent-gate');
    }

    function initSettingsUI() {
      renderEmojiPicker('chore-emoji-picker', CHORE_EMOJIS, selectedChoreEmoji, em => selectedChoreEmoji = em);
      renderEmojiPicker('reward-emoji-picker', REWARD_EMOJIS, selectedRewardEmoji, em => selectedRewardEmoji = em);
      renderSettingsLists();
    }

    function renderEmojiPicker(containerId, list, current, onSelect) {
      const el = document.getElementById(containerId);
      el.innerHTML = list.map(em => `
        <button type="button" class="text-xl p-1.5 border-2 rounded-xl ${em === current ? 'border-orange-500 bg-orange-100 scale-105' : 'border-slate-300 bg-white'}">
          ${em}
        </button>
      `).join('');

      el.querySelectorAll('button').forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          onSelect(list[idx]);
          renderEmojiPicker(containerId, list, list[idx], onSelect);
        });
      });
    }

    function renderSettingsLists() {
      const cList = document.getElementById('settings-chore-list');
      cList.innerHTML = appState.chores.map(c => {
        const catIcon = c.cat === 'smart' ? '💧' : c.cat === 'kind' ? '🌿' : '🔥';
        return `
          <div class="flex items-center justify-between bg-slate-50 border-2 border-slate-200 rounded-xl p-2">
            <div class="text-xs sm:text-sm font-extrabold">
              ${c.icon} ${escapeHTML(c.name)} <span class="text-orange-600">(${c.pt}pt / ${catIcon})</span>
            </div>
            <div class="flex gap-1.5">
              <button type="button" onclick="startEditChore('${c.id}')" class="bg-sky-100 border border-slate-900 rounded-lg px-2 py-1 text-xs font-black">編集</button>
              <button type="button" onclick="deleteChore('${c.id}')" class="bg-red-100 text-red-700 border border-red-400 rounded-lg px-2 py-1 text-xs font-black">削除</button>
            </div>
          </div>
        `;
      }).join('');

      const rList = document.getElementById('settings-reward-list');
      rList.innerHTML = appState.rewards.map(r => `
        <div class="flex items-center justify-between bg-slate-50 border-2 border-slate-200 rounded-xl p-2">
          <div class="text-xs sm:text-sm font-extrabold">
            ${r.icon} ${escapeHTML(r.name)} <span class="text-blue-600">(${r.cost}pt)</span>
          </div>
          <div class="flex gap-1.5">
            <button type="button" onclick="startEditReward('${r.id}')" class="bg-sky-100 border border-slate-900 rounded-lg px-2 py-1 text-xs font-black">編集</button>
            <button type="button" onclick="deleteReward('${r.id}')" class="bg-red-100 text-red-700 border border-red-400 rounded-lg px-2 py-1 text-xs font-black">削除</button>
          </div>
        </div>
      `).join('');
    }

    window.startEditChore = function(id) {
      const t = appState.chores.find(c => c.id === id);
      if (!t) return;
      document.getElementById('edit-chore-id').value = t.id;
      document.getElementById('input-chore-name').value = t.name;
      document.getElementById('input-chore-pt').value = t.pt;
      document.getElementById('input-chore-cat').value = t.cat || 'power';
      selectedChoreEmoji = t.icon;
      renderEmojiPicker('chore-emoji-picker', CHORE_EMOJIS, selectedChoreEmoji, em => selectedChoreEmoji = em);
      document.getElementById('chore-form-heading').textContent = '✏️ お手伝いを編集する';
      document.getElementById('cancel-chore-edit-btn').classList.remove('hidden');
    };

    window.deleteChore = function(id) {
      if (appState.chores.length <= 1) {
        showToast('おてつだいは 1つ以上 のこしてください');
        return;
      }
      appState.chores = appState.chores.filter(c => c.id !== id);
      saveState();
      renderSettingsLists();
      updateAllUI();
      showToast('削除しました');
    };

    window.startEditReward = function(id) {
      const t = appState.rewards.find(r => r.id === id);
      if (!t) return;
      document.getElementById('edit-reward-id').value = t.id;
      document.getElementById('input-reward-name').value = t.name;
      document.getElementById('input-reward-cost').value = t.cost;
      selectedRewardEmoji = t.icon;
      renderEmojiPicker('reward-emoji-picker', REWARD_EMOJIS, selectedRewardEmoji, em => selectedRewardEmoji = em);
      document.getElementById('reward-form-heading').textContent = '✏️ ごほうびを編集する';
      document.getElementById('cancel-reward-edit-btn').classList.remove('hidden');
    };

    window.deleteReward = function(id) {
      if (appState.rewards.length <= 1) {
        showToast('ごほうびは 1つ以上 のこしてください');
        return;
      }
      appState.rewards = appState.rewards.filter(r => r.id !== id);
      saveState();
      renderSettingsLists();
      updateAllUI();
      showToast('削除しました');
    };

    function resetChoreForm() {
      document.getElementById('edit-chore-id').value = '';
      document.getElementById('input-chore-name').value = '';
      document.getElementById('input-chore-pt').value = 2;
      document.getElementById('input-chore-cat').value = 'power';
      document.getElementById('chore-form-heading').innerHTML = '➕ 新しいお<ruby>手伝<rt>てつだ</rt></ruby>いをついか';
      document.getElementById('cancel-chore-edit-btn').classList.add('hidden');
    }

    function resetRewardForm() {
      document.getElementById('edit-reward-id').value = '';
      document.getElementById('input-reward-name').value = '';
      document.getElementById('input-reward-cost').value = 10;
      document.getElementById('reward-form-heading').textContent = '➕ 新しいごほうびをついか';
      document.getElementById('cancel-reward-edit-btn').classList.add('hidden');
    }

    /* =========================================================================
       8. 紙吹雪（Confetti）＆ユーティリティ
       ========================================================================= */
    function launchConfetti(durationMs = 2500) {
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6', '#ec4899'];
      const particles = Array.from({ length: 95 }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * -canvas.height,
        w: Math.random() * 10 + 6,
        h: Math.random() * 6 + 4,
        color: colors[Math.floor(Math.random() * colors.length)],
        vy: Math.random() * 4 + 2.8,
        vx: (Math.random() - 0.5) * 3,
        rot: Math.random() * 360,
        vRot: (Math.random() - 0.5) * 10
      }));

      const endTime = Date.now() + durationMs;

      function frame() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vRot;

          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rot * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
          ctx.restore();
        });

        if (Date.now() < endTime) {
          requestAnimationFrame(frame);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }
      requestAnimationFrame(frame);
    }

    function openModal(id) {
      const el = document.getElementById(id);
      el.classList.remove('hidden');
      el.classList.add('flex');
    }

    window.closeModal = function(id) {
      const el = document.getElementById(id);
      el.classList.add('hidden');
      el.classList.remove('flex');
    };

    let toastTimer = null;
    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.remove('opacity-0', '-translate-y-6');
      el.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        el.classList.add('opacity-0', '-translate-y-6');
        el.classList.remove('opacity-100', 'translate-y-0');
      }, 2300);
    }

    function escapeHTML(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    /* =========================================================================
       9. イベントリスナー初期化
       ========================================================================= */
    document.addEventListener('DOMContentLoaded', () => {
      loadState();
      initSettingsUI();

      // 初回または次周回でパートナー未選択ならタマゴ選択モーダルを表示
      if (!appState.activePartner) {
        openModal('modal-egg-select');
      } else {
        const curM = getCurrentMonsterData(appState.activePartner);
        if (curM) unlockMonsterInZukan(curM.id);
        updateAllUI();
      }

      // 次のタマゴを選ぶCTAボタン
      document.getElementById('start-next-egg-btn').addEventListener('click', () => {
        window.startNextCycleEgg();
      });

      // ミュート切替
      const soundBtn = document.getElementById('sound-toggle-btn');
      soundBtn.textContent = appState.muted ? '🔇' : '🔊';
      soundBtn.addEventListener('click', () => {
        appState.muted = !appState.muted;
        SoundFX.muted = appState.muted;
        soundBtn.textContent = appState.muted ? '🔇' : '🔊';
        saveState();
        if (!appState.muted) SoundFX.playCoin();
      });

      // モンスタータップ反応
      document.getElementById('monster-tap-area').addEventListener('click', () => {
        if (!appState.activePartner) return;
        const lv = getLevelFromExp(appState.activePartner.expPt);
        SoundFX.playMonsterCry(lv);
        bounceMonster();
      });

      // お手伝いカテゴリフィルター
      document.querySelectorAll('.chore-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.chore-filter-btn').forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('bg-white');
          });
          btn.classList.remove('bg-white');
          btn.classList.add('bg-slate-900', 'text-white');
          currentChoreFilter = btn.dataset.filter;
          renderChoresTab();
        });
      });

      // 下部タブ切り替え
      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.nav-item').forEach(b => {
            b.classList.remove('active', 'bg-yellow-300', 'text-slate-900', 'border-2', 'border-slate-900', 'font-black');
            b.classList.add('text-slate-500', 'font-extrabold');
          });
          btn.classList.remove('text-slate-500', 'font-extrabold');
          btn.classList.add('active', 'bg-yellow-300', 'text-slate-900', 'border-2', 'border-slate-900', 'font-black');

          const targetTab = btn.dataset.tab;
          document.querySelectorAll('.tab-section').forEach(sec => {
            sec.classList.toggle('hidden', sec.id !== targetTab);
          });

          if (targetTab === 'tab-calendar') renderCalendar();
          if (targetTab === 'tab-rewards') renderRewardsTab();
          if (targetTab === 'tab-zukan') renderZukanTab();
        });
      });

      // 図鑑の属性タブ切り替え
      document.querySelectorAll('.zukan-attr-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentZukanAttr = btn.dataset.attr;
          document.querySelectorAll('.zukan-attr-btn').forEach(b => {
            const attr = b.dataset.attr;
            if (attr === currentZukanAttr) {
              b.className = `zukan-attr-btn game-btn ${attr === 'fire' ? 'bg-red-500' : attr === 'water' ? 'bg-blue-500' : 'bg-green-600'} text-white text-xs sm:text-sm font-black py-2 rounded-xl`;
            } else {
              b.className = `zukan-attr-btn game-btn bg-white ${attr === 'fire' ? 'text-red-600' : attr === 'water' ? 'text-blue-600' : 'text-green-600'} text-xs sm:text-sm font-black py-2 rounded-xl`;
            }
          });
          renderZukanTab();
        });
      });

      // カレンダー月移動
      document.getElementById('cal-prev-btn').addEventListener('click', () => {
        currentCalMonth--;
        if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
        renderCalendar();
      });

      document.getElementById('cal-next-btn').addEventListener('click', () => {
        currentCalMonth++;
        if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
        renderCalendar();
      });

      document.getElementById('cal-today-btn').addEventListener('click', () => {
        const now = new Date();
        currentCalYear = now.getFullYear();
        currentCalMonth = now.getMonth();
        renderCalendar();
      });

      // 設定ボタン（保護者ゲート）
      document.getElementById('open-settings-btn').addEventListener('click', openParentGate);

      document.getElementById('gate-submit-btn').addEventListener('click', () => {
        const val = Number(document.getElementById('gate-answer-input').value);
        if (val === gateExpectedAnswer) {
          closeModal('modal-parent-gate');
          renderSettingsLists();
          openModal('modal-settings');
        } else {
          showToast('こたえが ちがうよ！もういちど けいさんしてね');
        }
      });

      // 設定内タブ切替
      document.getElementById('set-tab-chores').addEventListener('click', () => {
        document.getElementById('settings-chores-panel').classList.remove('hidden');
        document.getElementById('settings-rewards-panel').classList.add('hidden');
        document.getElementById('set-tab-chores').classList.replace('bg-sky-100', 'bg-yellow-300');
        document.getElementById('set-tab-rewards').classList.replace('bg-yellow-300', 'bg-sky-100');
      });

      document.getElementById('set-tab-rewards').addEventListener('click', () => {
        document.getElementById('settings-chores-panel').classList.add('hidden');
        document.getElementById('settings-rewards-panel').classList.remove('hidden');
        document.getElementById('set-tab-rewards').classList.replace('bg-sky-100', 'bg-yellow-300');
        document.getElementById('set-tab-chores').classList.replace('bg-yellow-300', 'bg-sky-100');
      });

      // お手伝い保存
      document.getElementById('save-chore-btn').addEventListener('click', () => {
        const name = document.getElementById('input-chore-name').value.trim();
        const pt = Math.max(1, Number(document.getElementById('input-chore-pt').value) || 1);
        const cat = document.getElementById('input-chore-cat').value || 'power';
        const editId = document.getElementById('edit-chore-id').value;

        if (!name) {
          showToast('なまえを 入力してください');
          return;
        }

        if (editId) {
          const t = appState.chores.find(c => c.id === editId);
          if (t) {
            t.name = name;
            t.pt = pt;
            t.cat = cat;
            t.icon = selectedChoreEmoji;
          }
        } else {
          appState.chores.push({
            id: 'c_' + Date.now(),
            name,
            pt,
            cat,
            icon: selectedChoreEmoji
          });
        }

        saveState();
        resetChoreForm();
        renderSettingsLists();
        updateAllUI();
        showToast('おてつだいを ほぞんしました！');
      });

      document.getElementById('cancel-chore-edit-btn').addEventListener('click', resetChoreForm);

      // ごほうび保存
      document.getElementById('save-reward-btn').addEventListener('click', () => {
        const name = document.getElementById('input-reward-name').value.trim();
        const cost = Math.max(1, Number(document.getElementById('input-reward-cost').value) || 1);
        const editId = document.getElementById('edit-reward-id').value;

        if (!name) {
          showToast('なまえを 入力してください');
          return;
        }

        if (editId) {
          const t = appState.rewards.find(r => r.id === editId);
          if (t) {
            t.name = name;
            t.cost = cost;
            t.icon = selectedRewardEmoji;
          }
        } else {
          appState.rewards.push({
            id: 'r_' + Date.now(),
            name,
            cost,
            icon: selectedRewardEmoji
          });
        }

        saveState();
        resetRewardForm();
        renderSettingsLists();
        updateAllUI();
        showToast('ごほうびを ほぞんしました！');
      });

      document.getElementById('cancel-reward-edit-btn').addEventListener('click', resetRewardForm);

      // 全データ初期化
      let resetConfirmStep = false;
      document.getElementById('reset-all-data-btn').addEventListener('click', (e) => {
        if (!resetConfirmStep) {
          resetConfirmStep = true;
          e.target.textContent = '⚠️ 本当に消しますか？（もういちど押すと初期化）';
          setTimeout(() => {
            resetConfirmStep = false;
            e.target.textContent = '⚠️ データをすべてしょき化する';
          }, 4000);
        } else {
          localStorage.removeItem(STORAGE_KEY);
          location.reload();
        }
      });
    });
  </script>
</body>
</html>
