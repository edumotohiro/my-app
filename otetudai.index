<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>お手伝いモンスターズ！進化＆図鑑コレクション</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- 丸ゴシック系フォント -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      font-family: 'M PLUS Rounded 1c', sans-serif;
      background-color: #e0f2fe;
      background-image: radial-gradient(#bae6fd 2.5px, transparent 2.5px);
      background-size: 26px 26px;
      color: #1e293b;
      padding-bottom: 92px;
      overflow-x: hidden;
    }

    ruby rt {
      font-size: 0.62em;
      font-weight: 700;
      color: #475569;
    }

    /* ゲーム風立体ボーダー＆シャドウ */
    .game-box {
      border: 3.5px solid #1e293b;
      box-shadow: 0 5px 0 #1e293b;
    }
    .game-box-lg {
      border: 4px solid #1e293b;
      box-shadow: 0 7px 0 #1e293b;
    }
    .game-btn {
      border: 3px solid #1e293b;
      box-shadow: 0 4px 0 #1e293b;
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .game-btn:active:not(:disabled) {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #1e293b;
    }
    .game-btn:disabled {
      opacity: 0.55;
      box-shadow: none;
      transform: translateY(2px);
      cursor: not-allowed;
    }

    /* モンスター浮遊・ジャンプアニメーション */
    @keyframes monsterFloat {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-8px) scale(1.03); }
    }
    .monster-float {
      animation: monsterFloat 2.6s ease-in-out infinite;
    }

    @keyframes monsterJump {
      0% { transform: scale(1); }
      25% { transform: scale(1.22, 0.82) translateY(8px); }
      55% { transform: scale(0.9, 1.15) translateY(-24px); }
      100% { transform: scale(1) translateY(0); }
    }
    .monster-jump {
      animation: monsterJump 0.5s ease !important;
    }

    @keyframes spinSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .aura-spin {
      animation: spinSlow 16s linear infinite;
    }

    /* フローティングポイント */
    .floating-pt {
      position: fixed;
      pointer-events: none;
      font-size: 1.5rem;
      font-weight: 900;
      color: #f97316;
      text-shadow: 2px 2px 0 #fff, -2px -2px 0 #fff, 2px -2px 0 #fff, -2px 2px 0 #fff;
      z-index: 250;
      animation: floatUpFade 1s ease-out forwards;
    }
    @keyframes floatUpFade {
      0% { opacity: 1; transform: translateY(0) scale(0.85); }
      40% { opacity: 1; transform: translateY(-32px) scale(1.2); }
      100% { opacity: 0; transform: translateY(-75px) scale(1); }
    }

    /* チケット模様 */
    .ticket-pattern {
      background: repeating-linear-gradient(
        45deg,
        #fef08a,
        #fef08a 12px,
        #fde047 12px,
        #fde047 24px
      );
    }

    /* モーダル背景 */
    .modal-backdrop {
      background: rgba(15, 23, 42, 0.72);
      backdrop-filter: blur(3px);
    }

    /* スクロールバー非表示（横スクロール等） */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
  </style>
</head>
<body class="min-h-screen">

  <!-- 紙吹雪用キャンバス -->
  <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-[300]"></canvas>

  <!-- トースト通知 -->
  <div id="toast" class="fixed top-20 left-1/2 -translate-x-1/2 -translate-y-6 bg-slate-900 text-white px-5 py-2.5 rounded-full font-extrabold text-sm z-[260] opacity-0 pointer-events-none transition-all duration-200 shadow-lg whitespace-nowrap"></div>

  <!-- ヘッダー -->
  <header class="sticky top-0 z-40 bg-gradient-to-r from-red-600 via-red-500 to-orange-500 text-white border-b-4 border-slate-900 shadow-md px-3 pt-2.5 pb-3">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <span class="text-2xl drop-shadow">🔴</span>
          <h1 class="text-lg sm:text-xl font-black tracking-tight drop-shadow-[0_2px_0_rgba(127,29,29,1)]">
            お<ruby>手伝<rt>てつだ</rt></ruby>いモンスターズ
          </h1>
          <span id="cycle-badge" class="bg-yellow-300 text-slate-900 text-xs font-black px-2.5 py-0.5 rounded-full border-2 border-slate-900 shadow-sm">
            1しゅうめ
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button id="sound-toggle-btn" class="w-9 h-9 rounded-full bg-white/20 border-2 border-white/70 flex items-center justify-center text-base active:scale-90 transition" title="おとのオン・オフ">🔊</button>
          <button id="open-settings-btn" class="w-9 h-9 rounded-full bg-white/20 border-2 border-white/70 flex items-center justify-center text-base active:scale-90 transition" title="おうちのひとせってい">⚙️</button>
        </div>
      </div>

      <!-- ポイントバー -->
      <div class="grid grid-cols-2 gap-2.5">
        <div class="bg-white text-slate-900 rounded-2xl px-3 py-1.5 border-[3px] border-slate-900 shadow-[0_3px_0_#0f172a] flex flex-col items-center">
          <span class="text-[11px] sm:text-xs font-extrabold text-slate-600">💰 つかえるポイント</span>
          <div class="text-xl sm:text-2xl font-black text-orange-600 leading-tight">
            <span id="usable-points">0</span><span class="text-xs ml-0.5">pt</span>
          </div>
        </div>
        <div class="bg-white text-slate-900 rounded-2xl px-3 py-1.5 border-[3px] border-slate-900 shadow-[0_3px_0_#0f172a] flex flex-col items-center">
          <span class="text-[11px] sm:text-xs font-extrabold text-slate-600">⭐ るいけいポイント</span>
          <div class="text-xl sm:text-2xl font-black text-blue-600 leading-tight">
            <span id="total-points">0</span><span class="text-xs ml-0.5">pt</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="max-w-2xl mx-auto p-3 sm:p-4">

    <!-- 相棒モンスター育成ステージ -->
    <section id="monster-stage-card" class="game-box-lg rounded-3xl p-4 mb-5 bg-gradient-to-b from-amber-100 via-white to-sky-100 relative overflow-hidden">
      <!-- 上部バッジ行 -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2 relative z-10">
        <div class="flex items-center gap-1.5">
          <span id="monster-level-badge" class="bg-slate-900 text-yellow-300 text-xs sm:text-sm font-black px-3 py-1 rounded-full">
            Lv.1 / 10
          </span>
          <span id="monster-type-badge" class="bg-orange-500 text-white text-xs font-black px-2.5 py-1 rounded-full border-2 border-slate-900">
            🔥 ほのお
          </span>
        </div>
        <span id="monster-route-badge" class="bg-white/90 text-slate-800 text-xs font-extrabold px-2.5 py-1 rounded-full border-2 border-slate-900">
          🌱 せいちょう中
        </span>
      </div>

      <!-- モンスター表示エリア（タップ可能） -->
      <div id="monster-tap-area" class="flex flex-col items-center justify-center py-2 cursor-pointer relative z-10" title="タップしてみよう！">
        <div class="relative w-40 h-40 sm:w-44 sm:h-44 flex items-center justify-center">
          <!-- 回転する背景オーラSVG -->
          <div id="monster-aura-bg" class="absolute inset-0 flex items-center justify-center opacity-75 pointer-events-none"></div>
          <!-- モンスター本体（カスタムSVG＋絵文字融合デザイン） -->
          <div id="monster-visual-container" class="monster-float w-36 h-36 sm:w-40 sm:h-40 flex items-center justify-center relative z-10"></div>
        </div>

        <h2 id="monster-name" class="text-xl sm:text-2xl font-black text-slate-900 mt-1 text-center">
          ほのおのタマゴ
        </h2>
      </div>

      <!-- セリフ吹き出し -->
      <div id="monster-speech" class="bg-white border-2 border-slate-400 rounded-2xl px-3.5 py-2 text-xs sm:text-sm font-extrabold text-slate-700 text-center mb-3 relative z-10 shadow-sm">
        お<ruby>手伝<rt>てつだ</rt></ruby>いをすると ぼくが そだつよ！
      </div>

      <!-- レベルアップ＆進化ゲージ -->
      <div class="bg-white/95 rounded-2xl p-3 border-2 border-slate-300 mb-3 relative z-10">
        <div class="flex justify-between items-center text-xs sm:text-sm font-extrabold mb-1.5">
          <span id="exp-stage-label" class="text-slate-700">つぎのレベルまで</span>
          <span id="exp-remaining-text" class="text-orange-600 font-black">あと 5 pt！</span>
        </div>
        <div class="w-full h-4 bg-slate-200 rounded-full overflow-hidden border-2 border-slate-900">
          <div id="exp-bar-fill" class="h-full bg-gradient-to-r from-green-500 via-lime-400 to-yellow-400 transition-all duration-500" style="width: 0%;"></div>
        </div>

        <!-- 殿堂入り達成時の次周回ボタン（Lv.10到達時のみ表示） -->
        <div id="next-egg-cta" class="hidden mt-3 pt-2.5 border-t-2 border-dashed border-amber-300 text-center">
          <p class="text-xs sm:text-sm font-black text-amber-700 mb-2">
            👑 さいこうレベル（Lv.10）に <ruby>到達<rt>とうたつ</rt></ruby>したよ！
          </p>
          <button id="start-next-egg-btn" class="game-btn w-full bg-gradient-to-r from-yellow-400 to-orange-400 text-slate-900 font-black py-2.5 px-4 rounded-2xl text-sm sm:text-base">
            🥚 あたらしいタマゴを えらぶ！（つぎのしゅうへ）
          </button>
        </div>
      </div>

      <!-- お手伝い傾向ステータスバー（進化ルート分岐ヒント） -->
      <div class="bg-white/95 rounded-2xl p-3 border-2 border-slate-300 relative z-10">
        <div class="flex items-center justify-between text-xs font-black mb-1.5">
          <span>📊 このタマゴの お<ruby>手伝<rt>てつだ</rt></ruby>いバランス</span>
          <span id="tendency-total-pt" class="text-slate-500">いくせい 0 pt</span>
        </div>

        <!-- 3色比率バー -->
        <div class="w-full h-3.5 bg-slate-200 rounded-full overflow-hidden border-2 border-slate-900 flex mb-2">
          <div id="bar-power" class="bg-red-500 h-full transition-all duration-300" style="width: 33.3%;"></div>
          <div id="bar-smart" class="bg-blue-500 h-full transition-all duration-300" style="width: 33.4%;"></div>
          <div id="bar-kind" class="bg-green-500 h-full transition-all duration-300" style="width: 33.3%;"></div>
        </div>

        <!-- タイプ別ポイント内訳 -->
        <div class="grid grid-cols-3 gap-1 text-[11px] sm:text-xs font-extrabold text-center mb-2">
          <div class="bg-red-50 text-red-700 rounded-lg py-1 border border-red-200">
            🔥 パワー: <span id="pt-power">0</span>pt
          </div>
          <div class="bg-blue-50 text-blue-700 rounded-lg py-1 border border-blue-200">
            💧 ちえ: <span id="pt-smart">0</span>pt
          </div>
          <div class="bg-green-50 text-green-700 rounded-lg py-1 border border-green-200">
            🌿 やさしさ: <span id="pt-kind">0</span>pt
          </div>
        </div>

        <!-- 分岐ヒントメッセージ -->
        <div id="branch-hint-box" class="bg-amber-50 border border-amber-300 rounded-xl px-2.5 py-1.5 text-xs font-extrabold text-amber-900 text-center">
          💡 Lv.5になると おおいタイプによって <ruby>進化<rt>しんか</rt></ruby>ルートがきまるよ！
        </div>
      </div>
    </section>

    <!-- ==================== タブ1：おてつだい ==================== -->
    <section id="tab-chores" class="tab-section">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base sm:text-lg font-black text-slate-900">
          ⚡ お<ruby>手伝<rt>てつだ</rt></ruby>いボタンを押そう！
        </h3>
        <span id="today-date-label" class="bg-white border-2 border-slate-900 rounded-full px-3 py-0.5 text-xs sm:text-sm font-black">
          今日
        </span>
      </div>

      <!-- カテゴリフィルター -->
      <div class="flex gap-1.5 overflow-x-auto no-scrollbar pb-2 mb-2">
        <button class="chore-filter-btn active bg-slate-900 text-white text-xs font-black px-3 py-1.5 rounded-full border-2 border-slate-900 whitespace-nowrap" data-filter="all">
          すべて
        </button>
        <button class="chore-filter-btn bg-white text-red-600 text-xs font-black px-3 py-1.5 rounded-full border-2 border-slate-900 whitespace-nowrap" data-filter="power">
          🔥 パワー系
        </button>
        <button class="chore-filter-btn bg-white text-blue-600 text-xs font-black px-3 py-1.5 rounded-full border-2 border-slate-900 whitespace-nowrap" data-filter="smart">
          💧 ちえ・きれい系
        </button>
        <button class="chore-filter-btn bg-white text-green-600 text-xs font-black px-3 py-1.5 rounded-full border-2 border-slate-900 whitespace-nowrap" data-filter="kind">
          🌿 やさしさ系
        </button>
      </div>

      <!-- お手伝いボタン一覧 -->
      <div id="chore-list-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5"></div>

      <!-- 今日のやったことリスト -->
      <div class="game-box bg-white rounded-2xl p-3.5">
        <div class="flex items-center justify-between font-black text-sm sm:text-base mb-2 pb-1.5 border-b-2 border-slate-100">
          <span>📝 今日やったことリスト</span>
          <span id="today-earned-sum" class="text-orange-600">合計 0 pt</span>
        </div>
        <div id="today-log-list" class="divide-y divide-dashed divide-slate-200"></div>
      </div>
    </section>

    <!-- ==================== タブ2：カレンダー ==================== -->
    <section id="tab-calendar" class="tab-section hidden">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base sm:text-lg font-black text-slate-900">
          📅 お<ruby>手伝<rt>てつだ</rt></ruby>いカレンダー
        </h3>
        <button id="cal-today-btn" class="game-btn bg-sky-100 text-slate-900 text-xs font-black px-3 py-1.5 rounded-xl">
          今日にもどる
        </button>
      </div>

      <div class="game-box-lg bg-white rounded-3xl p-3.5">
        <div class="flex items-center justify-between mb-3">
          <button id="cal-prev-btn" class="game-btn bg-slate-100 text-xs sm:text-sm font-black px-3 py-1.5 rounded-xl">
            ◀ まえの月
          </button>
          <div id="cal-month-title" class="text-base sm:text-lg font-black">2026年 11月</div>
          <button id="cal-next-btn" class="game-btn bg-slate-100 text-xs sm:text-sm font-black px-3 py-1.5 rounded-xl">
            つぎの月 ▶
          </button>
        </div>

        <div class="grid grid-cols-7 text-center font-black text-xs sm:text-sm mb-1.5">
          <div class="text-red-500">日</div>
          <div>月</div>
          <div>火</div>
          <div>水</div>
          <div>木</div>
          <div>金</div>
          <div class="text-blue-500">土</div>
        </div>

        <div id="cal-grid" class="grid grid-cols-7 gap-1.5"></div>
      </div>
      <p class="text-xs font-extrabold text-slate-600 text-center mt-2.5">
        💡 日にちをタップすると、その日のきろくを見たり、あとからついかできるよ！
      </p>
    </section>

    <!-- ==================== タブ3：ごほうび ==================== -->
    <section id="tab-rewards" class="tab-section hidden">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base sm:text-lg font-black text-slate-900">
          🎁 ごほうび<ruby>交換<rt>こうかん</rt></ruby>ショップ
        </h3>
      </div>

      <div id="reward-list-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5"></div>

      <div class="game-box bg-white rounded-2xl p-3.5">
        <div class="font-black text-sm sm:text-base mb-2 pb-1.5 border-b-2 border-slate-100">
          🎟️ これまでにもらったごほうびチケット
        </div>
        <div id="reward-history-list" class="divide-y divide-dashed divide-slate-200"></div>
      </div>
    </section>

    <!-- ==================== タブ4：ずかん ==================== -->
    <section id="tab-zukan" class="tab-section hidden">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h3 class="text-base sm:text-lg font-black text-slate-900">
          📖 モンスター<ruby>図鑑<rt>ずかん</rt></ruby>
        </h3>
        <span id="zukan-progress-badge" class="bg-yellow-300 border-2 border-slate-900 rounded-full px-3 py-0.5 text-xs font-black">
          発見数: 1 / 39
        </span>
      </div>

      <!-- 殿堂入りコレクション枠 -->
      <div class="game-box bg-gradient-to-r from-amber-50 to-yellow-100 rounded-2xl p-3.5 mb-4">
        <div class="font-black text-sm text-amber-900 mb-2 flex items-center justify-between">
          <span>👑 <ruby>殿堂入<rt>でんどうい</rt></ruby>りした パートナーたち（Lv.10<ruby>達成<rt>たっせい</rt></ruby>）</span>
          <span id="hof-count" class="text-xs bg-amber-300 px-2 py-0.5 rounded-full border border-slate-900">0ひき</span>
        </div>
        <div id="hall-of-fame-list" class="flex gap-2.5 overflow-x-auto pb-1"></div>
      </div>

      <!-- 属性切り替えタブ -->
      <div class="grid grid-cols-3 gap-2 mb-3">
        <button class="zukan-attr-btn game-btn bg-red-500 text-white text-xs sm:text-sm font-black py-2 rounded-xl" data-attr="fire">
          🔥 ほのお
        </button>
        <button class="zukan-attr-btn game-btn bg-white text-blue-600 text-xs sm:text-sm font-black py-2 rounded-xl" data-attr="water">
          💧 みず
        </button>
        <button class="zukan-attr-btn game-btn bg-white text-green-600 text-xs sm:text-sm font-black py-2 rounded-xl" data-attr="forest">
          🌿 もり
        </button>
      </div>

      <!-- 図鑑リスト本体 -->
      <div id="zukan-content-area" class="space-y-4"></div>
    </section>

  </main>

  <!-- 下部タブナビゲーション（4タブ） -->
  <nav class="fixed bottom-0 inset-x-0 bg-white border-t-4 border-slate-900 px-2 py-1.5 z-40">
    <div class="max-w-2xl mx-auto grid grid-cols-4 gap-1.5">
      <button class="nav-item active flex flex-col items-center justify-center py-1 rounded-xl bg-yellow-300 text-slate-900 border-2 border-slate-900 font-black text-xs" data-tab="tab-chores">
        <span class="text-xl leading-none mb-0.5">💪</span>
        <span>お<ruby>手伝<rt>てつだ</rt></ruby>い</span>
      </button>
      <button class="nav-item flex flex-col items-center justify-center py-1 rounded-xl text-slate-500 font-extrabold text-xs" data-tab="tab-calendar">
        <span class="text-xl leading-none mb-0.5">📅</span>
        <span>カレンダー</span>
      </button>
      <button class="nav-item flex flex-col items-center justify-center py-1 rounded-xl text-slate-500 font-extrabold text-xs" data-tab="tab-rewards">
        <span class="text-xl leading-none mb-0.5">🎁</span>
        <span>ごほうび</span>
      </button>
      <button class="nav-item flex flex-col items-center justify-center py-1 rounded-xl text-slate-500 font-extrabold text-xs" data-tab="tab-zukan">
        <span class="text-xl leading-none mb-0.5">📖</span>
        <span>ずかん</span>
      </button>
    </div>
  </nav>

  <!-- ==================== モーダル1：パートナー（タマゴ）選択 ==================== -->
  <div id="modal-egg-select" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center p-3">
    <div class="game-box-lg bg-white rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-4 sm:p-5">
      <div class="text-center mb-3">
        <span class="inline-block bg-yellow-300 border-2 border-slate-900 rounded-full px-3 py-0.5 text-xs font-black mb-1">
          🥚 パートナーえらび
        </span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900">
          どのタマゴを そだてる？
        </h2>
        <p class="text-xs sm:text-sm font-bold text-slate-600 mt-1">
          お<ruby>手伝<rt>てつだ</rt></ruby>いのやりかた（パワー・ちえ・やさしさ）で<br>Lv.5から 3つのルートに <ruby>進化<rt>しんか</rt></ruby>がわかれるよ！
        </p>
      </div>

      <div class="space-y-3" id="egg-choice-list">
        <!-- ほのお -->
        <button type="button" onclick="selectStarterEgg('fire')" class="game-btn w-full text-left bg-gradient-to-r from-red-50 to-orange-100 p-3.5 rounded-2xl flex items-center gap-3.5">
          <div class="w-16 h-16 rounded-2xl bg-white border-2 border-slate-900 flex items-center justify-center text-4xl shrink-0 shadow-sm">
            🔥🥚
          </div>
          <div>
            <div class="text-base sm:text-lg font-black text-red-700">ほのおのタマゴ</div>
